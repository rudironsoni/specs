{
  "name": "@rudironsoni/specs-schema",
  "version": "0.30.0",
  "description": "Specs UI Component Schema - TypeScript types and JSON schema definitions for component specifications",
  "license": "MIT",
  "author": "Nathan Curtis",
  "repository": {
    "type": "git",
    "url": "https://github.com/rudironsoni/specs.git",
    "directory": "src/schema"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./schema/component": "./schema/component.schema.json",
    "./schema/workspace": "./schema/workspace.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "*.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "specs",
    "component",
    "schema",
    "figma",
    "design-system",
    "specifications",
    "types",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
