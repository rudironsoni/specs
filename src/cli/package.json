{
  "name": "@rudironsoni/specs-cli",
  "version": "0.30.0",
  "description": "Command-line interface for Specs design system operations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "specs": "./dist/specs.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "esbuild bin/specs.ts --bundle --platform=node --target=node18 --format=esm --packages=external --define:__SPECS_CLI_VERSION__=\\\"$npm_package_version\\\" --outfile=dist/specs.js --banner:js='#!/usr/bin/env node' && chmod +x dist/specs.js",
    "watch": "esbuild bin/specs.ts --bundle --platform=node --target=node18 --format=esm --packages=external --define:__SPECS_CLI_VERSION__=\\\"$npm_package_version\\\" --outfile=dist/specs.js --watch",
    "test": "cd ../.. && vitest -c vitest.config.ts src/cli/tests"
  },
  "dependencies": {
    "@rudironsoni/specs-schema": "^0.30.0",
    "@rudironsoni/specs-from-figma": "^0.30.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "yaml": "^2.3.4",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/fs-extra": "^11.0.4",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rudironsoni/specs.git",
    "directory": "src/cli"
  },
  "keywords": [
    "specs",
    "design-system",
    "cli",
    "figma"
  ],
  "author": "rudironsoni",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
