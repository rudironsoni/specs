{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rudironsoni/specs/cli/bootstrap/run.schema.json",
  "title": "Bootstrap run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "workflow",
    "startedAt",
    "inputDigests",
    "outputDigests",
    "completedNodes",
    "failedNodes",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string" },
    "workflow": { "type": "string" },
    "startedAt": { "type": "string" },
    "inputDigests": { "type": "object", "additionalProperties": { "type": "string" } },
    "outputDigests": { "type": "object", "additionalProperties": { "type": "string" } },
    "completedNodes": { "type": "array", "items": { "type": "string" } },
    "failedNodes": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } }
  }
}
